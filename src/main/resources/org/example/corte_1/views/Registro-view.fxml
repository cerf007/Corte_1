<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="433.0" prefWidth="405.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.corte_1.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" text="Registro de pacientes">
      <font>
         <Font name="Comic Sans MS" size="33.0" />
      </font></Label>
   <Separator prefWidth="200.0" />
   <Label text="Nombres" />
   <TextField />
   <Label text="Apellidos" />
   <TextField />
   <Label text="Teléfono" />
   <TextField />
   <Label text="Seleccionar la fecha de su cita" />
   <DatePicker />
    <Button onAction="#onHelloButtonClick" text="Enviar" />
</VBox>
